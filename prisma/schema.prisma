generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
  NURSE
  LAB_TECHNICIAN
  PHARMACIST
}

enum OtpPurpose {
  DEVICE_VERIFICATION
  ACCOUNT_ACTIVATION
  PASSWORD_RESET
}

model Hospital {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments        Department[]
  users              User[]
  patients           Patient[]
  authorizedNetworks AuthorizedNetwork[]

  @@index([name])
}

model Department {
  id         String   @id @default(uuid())
  hospitalId String
  name       String
  code       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  users    User[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

model User {
  id                 String   @id @default(uuid())
  staffId            String?  @unique
  hospitalId         String
  departmentId       String?
  email              String   @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               UserRole @default(NURSE)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  hospital       Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  sessions       Session[]
  trustedDevices TrustedDevice[]
  authOtps       AuthOtp[]
  authChallenges AuthChallenge[]

  @@index([hospitalId])
  @@index([departmentId])
  @@index([role])
  @@index([isActive])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum AuthChallengePurpose {
  DEVICE_VERIFICATION
  PASSWORD_CHANGE
}

model AuthChallenge {
  id          String               @id @default(uuid())
  userId      String
  purpose     AuthChallengePurpose
  tokenHash   String               @unique
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@index([completedAt])
}

model AuthorizedNetwork {
  id         String   @id @default(uuid())
  hospitalId String
  name       String
  cidr       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([isActive])
}

model TrustedDevice {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  deviceName String?
  lastIp     String?
  trustedAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuthOtp {
  id        String     @id @default(uuid())
  userId    String
  purpose   OtpPurpose
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
  @@index([usedAt])
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

model Patient {
  id             String        @id @default(uuid())
  hospitalId     String
  hospitalNumber String
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  gender         String
  phone          String?
  address        String?
  bloodGroup     String?
  status         PatientStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@unique([hospitalId, hospitalNumber])
  @@index([hospitalId])
  @@index([lastName, firstName])
}
