generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
  NURSE
  LAB_TECHNICIAN
  PHARMACIST
}

model Hospital {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  users       User[]
  patients    Patient[]

  @@index([name])
}

model Department {
  id         String   @id @default(uuid())
  hospitalId String
  name       String
  code       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  users    User[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

model User {
  id           String    @id @default(uuid())
  hospitalId   String
  departmentId String?
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(NURSE)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  @@index([departmentId])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Patient {
  id             String   @id @default(uuid())
  hospitalId     String
  hospitalNumber String
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  gender         String
  phone          String?
  address        String?
  bloodGroup     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@unique([hospitalId, hospitalNumber])
  @@index([hospitalId])
  @@index([lastName, firstName])
}
